ide = (event) => {\r\n    if (dropdownRef.current && !dropdownRef.current.contains(event.target) && !profileRef.current.contains(event.target)) {\r\n      setIsOpen(false)\r\n    }\r\n  }\r\n  \r\n  useEffect(() => {\r\n    document.addEventListener('mousedown', handleClickOutside)\r\n\r\n    return () => {\r\n      document.removeEventListener('mousedown', handleClickOutside)\r\n    }\r\n  }, [isOpen])\r\n  \r\n\r\n  const toggleDropdown = () => {\r\n    setIsOpen(!isOpen)\r\n  }\r\n\r\n  return (\r\n    <div className=\"header-container\">\r\n      <div className=\"header-section-container\">\r\n        <div className=\"profile-container\">\r\n          <CircleUserRound className=\"profile-icon\" onClick={toggleDropdown} ref={profileRef} />\r\n          {isOpen && (\r\n            <SignedInDrop username={username} isOpen={isOpen} dropdownRef={dropdownRef} />\r\n          )}\r\n        </div>\r\n      </div>\r\n    </div>\r\n  )\r\n}\r\n\r\nexport default Header",["117"],"C:\\Users\\Brian\\AttendanceManager\\client\\src\\components\\SideNav.jsx",[],[],"C:\\Users\\Brian\\AttendanceManager\\client\\src\\pages\\Settings.jsx",[],[],"C:\\Users\\Brian\\AttendanceManager\\client\\src\\App.js",[],[],["118"],"C:\\Users\\Brian\\AttendanceManager\\client\\src\\pages\\Register.jsx",["119","120","121"],["122","123","124","125","126","127","128","129","130","131","132","133"],"C:\\Users\\Brian\\AttendanceManager\\client\\src\\pages\\Login.jsx",["134","135","136"],[],"import React from 'react'\r\nimport { useState, useEffect } from 'react'\r\nimport './styles/Login.scss'\r\nimport monkey from \"../images/monkey.png\"\r\n\r\n\r\nconst Login = () => {\r\n    const [user, setUser] = useState('')\r\n    \r\n    const [pwd, setPwd] = useState('')\r\n\r\n    const handleSubmit = async (e) => {\r\n        e.preventDefault()\r\n    }\r\n\r\n    return (\r\n        <div className='container'>\r\n            <div className='login-container'>\r\n                <div className='login-input-section'>\r\n                    <div className=\"logo\">\r\n                        <img src={monkey} className='logo-image' alt=\"logo\" />\r\n                        <h1 className='logo-name'>AHEND</h1>\r\n                        <hr className='line'/>\r\n                    </div>\r\n                    <h2 className='register-header'>Login</h2>\r\n                    <form className='form-container' onSubmit={handleSubmit}>\r\n                        <div className='username-container'>\r\n                            <div className='input-wrapper'>\r\n                                <input\r\n                                    type='text'\r\n                                    id='username'\r\n                                    placeholder='Username'\r\n                                    onChange={(e) => setUser(e.target.value)}\r\n                                    required\r\n                                    aria-describedby='uidnote'\r\n                                />\r\n                            </div>\r\n                        </div>\r\n                        <div className='password-container'>\r\n                            <div className='input-wrapper'>\r\n                                <input\r\n                                    type='password'\r\n                                    id='password'\r\n                                    placeholder='Password'\r\n                                    onChange={(e) => setPwd(e.target.value)}\r\n                                    required\r\n                                    aria-describedby='pwdnote'\r\n                                />\r\n                            </div>\r\n                        </div>\r\n                        <div className='login-button-container'>\r\n                            <button \r\n                                className=\"login-button\"\r\n                                type='submit' \r\n                            >\r\n                             