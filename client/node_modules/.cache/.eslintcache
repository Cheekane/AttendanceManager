cribedby='pwdnote'\r\n                                />\r\n                            </div>\r\n                        </div>\r\n                        <div className='login-button-container'>\r\n                            <button \r\n                                className=\"login-button\"\r\n                                type='submit' \r\n                            >\r\n                                Log in\r\n                            </button>\r\n                        </div>\r\n                    </form>\r\n                    <div className='register-link-container'>\r\n                        Don't have an account?&nbsp;\r\n                        <a className='register-link' href=\"/register\">Sign up</a>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    )\r\n}\r\n\r\nexport default Login","C:\\Users\\Brian\\AttendanceManager\\client\\src\\components\\SignedInDrop.jsx",["151","152","153"],[],"C:\\Users\\Brian\\AttendanceManager\\client\\src\\pages\\Attendance.jsx",["154"],[],"C:\\Users\\Brian\\AttendanceManager\\client\\src\\components\\AddNewPerson.jsx",[],[],{"ruleId":"155","replacedBy":"156"},{"ruleId":"155","replacedBy":"157"},{"ruleId":"158","severity":1,"message":"159","line":75,"column":100,"nodeType":"160","messageId":"161","endLine":75,"endColumn":104,"suppressions":"162"},{"ruleId":"158","severity":1,"message":"159","line":75,"column":141,"nodeType":"160","messageId":"161","endLine":75,"endColumn":145,"suppressions":"163"},{"ruleId":"164","severity":1,"message":"165","line":75,"column":39200,"nodeType":"160","messageId":"166","endLine":75,"endColumn":39205,"suppressions":"167"},{"ruleId":"164","severity":1,"message":"168","line":75,"column":39302,"nodeType":"160","messageId":"166","endLine":75,"endColumn":39307,"suppressions":"169"},{"ruleId":"164","severity":1,"message":"170","line":75,"column":39396,"nodeType":"160","messageId":"166","endLine":75,"endColumn":39401,"suppressions":