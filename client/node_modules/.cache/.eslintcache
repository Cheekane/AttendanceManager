{ useState, useEffect, useRef } from 'react'\r\nimport { CircleUserRound } from 'lucide-react'\r\nimport SignedInDrop from './SignedInDrop'\r\nimport \"./styles/Header.scss\"\r\n\r\nconst Header = () => {\r\n  const [isOpen, setIsOpen] = useState(false)\r\n  const [username, setUsername] = useState('Guest')\r\n  const profileRef = useRef()\r\n  const dropdownRef = useRef()\r\n\r\n  const handleClickOutside = (event) => {\r\n    if (dropdownRef.current && !dropdownRef.current.contains(event.target) && !profileRef.current.contains(event.target)) {\r\n      setIsOpen(false)\r\n    }\r\n  }\r\n  \r\n  useEffect(() => {\r\n    document.addEventListener('mousedown', handleClickOutside)\r\n\r\n    return () => {\r\n      document.removeEventListener('mousedown', handleClickOutside)\r\n    }\r\n  }, [isOpen])\r\n  \r\n\r\n  const toggleDropdown = () => {\r\n    setIsOpen(!isOpen)\r\n  }\r\n\r\n  return (\r\n    <div className=\"header-container\">\r\n      <div className=\"header-section-container\">\r\n        <div className=\"profile-container\">\r\n          <CircleUserRound className=\"profile-icon\" onClick={toggleDropdown} ref={profileRef} />\r\n          {isOpen && (\r\n            <SignedInDrop username={username} isOpen={isOpen} dropdownRef={dropdownRef} />\r\n          )}\r\n        </div>\r\n      </div>\r\n    </div>\r\n  )\r\n}\r\n\r\nexport default Header","C:\\Users\\Brian\\AttendanceManager\\client\\src\\components\\SideNav.jsx",[],[],"C:\\Users\\Brian\\AttendanceManager\\client\\src\\pages\\Settings.jsx",[],[],"C:\\Users\\Brian\\AttendanceManager\\client\\src\\App.js",[],[],"C:\\Users\\Brian\\AttendanceManager\\client\\src\\pages\\Register.jsx",["130","131","132"],["133","134","135","136","137","138","139","140","141","142","143","144"],"C:\\Users\\Brian\\AttendanceManager\\client\\src\\pages\\Login.jsx",["145","146","147"],[],"C:\\Users\\Brian\\AttendanceManager\\client\\src\\components\\SignedInDrop.jsx",["148","149","150"],[],"C:\\Users\\Brian\\Attendanc